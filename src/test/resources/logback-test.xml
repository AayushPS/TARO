<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.springframework.boot.autoconfigure.logging.ConditionEvaluationReportLogger" level="OFF"/>
    <logger name="org.springframework.boot.test.context" level="WARN"/>
    <logger name="org.springframework.test.context" level="WARN"/>
    <logger name="org.springframework.boot.SpringApplication" level="WARN"/>
    <logger name="org.springframework.web.context.support" level="WARN"/>
    <logger name="org.springframework.web.servlet.mvc.method.annotation" level="WARN"/>
    <logger name="org.springframework.web.servlet.handler" level="WARN"/>
    <logger name="org.springframework.web.servlet.view" level="WARN"/>
    <logger name="org.springframework.web.method" level="WARN"/>
    <logger name="org.springframework.boot.web.servlet" level="WARN"/>
    <logger name="org.springframework.boot.web.servlet.ServletContextInitializerBeans" level="OFF"/>
    <logger name="org.springframework.boot.test.mock.web" level="WARN"/>
    <logger name="org.springframework.boot.test.mock.web.SpringBootMockServletContext" level="WARN"/>
    <logger name="org.springframework.boot.autoconfigure" level="WARN"/>
    <logger name="org.springframework.boot.availability" level="WARN"/>
    <logger name="org.springframework" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
